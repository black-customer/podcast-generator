  "segments": [
    {
      "text": "Do you prefer online shopping or in-store shopping?",
      "speaker": "a",
      "start": 0.0,
      "end": 3.38
    },
    {
      "text": "I'm more into in-store shopping, to be honest. In a store you can see things and touch them — I think touching is the most important part. There's a whole different experience: not just seeing, but touching, trying things on. But online shopping has its advantages too — it's so accessible. So mostly I do online shopping, but in my heart I prefer stores. Actually, if the technology ever developed to the point where I could just click my phone and be shopping in a real store — then I would definitely choose in-store shopping.",
      "speaker": "b",
      "start": 3.7,
      "end": 30.72
    }
  ],
