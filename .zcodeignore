# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/

# Sensitive Configuration & API Keys
data/settings.json
.env
.env.*
*.key
*.pem

# Test & Coverage Outputs
.pytest_cache/
.coverage
htmlcov/
test-results/
playwright-report/
playwright/.cache/

# Local Temporary & Scratch Files
data/.tmp/
tmp/
*.tmp
*.log

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini

# IDEs & Editor configs
.idea/
.vscode/
.zcode/
.impeccable/

# Temporary exported packs
data/exports/*.zip

# Lint cache
.ruff_cache/

# 音频策略：文本与 meta 入库（语料是产品本体），音频不入库（可再生、体积大）
# 例外：初始提交中已跟踪的音频保持跟踪，避免状态不一致
data/topics/**/audio*.mp3
data/episodes/*.mp3

# 题库快照：可再生（python -m server.bank --sync），且源自 Bruce 私有 RoastDuck 数据，不入库
data/question_bank.json

# 任务运行态：服务重启恢复用，非产品数据
data/jobs.json

