  "segments": [
    {
      "text": "What changes would you like to see in your school?",
      "speaker": "a",
      "start": 0.0,
      "end": 1.93
    },
    {
      "text": "I have a lot to say about this, but mainly — the takeout situation. I usually order takeout at school, but my school doesn't offer a proper place to put it. Everything just gets left at the gate, and some people go there and pick up takeout that isn't even theirs — they basically steal other people's food. So I really wish my school would build a takeout cupboard, or at least a better place to store it, so our takeout doesn't get stolen so easily.",
      "speaker": "b",
      "start": 2.47,
      "end": 26.07
    }
