# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini

# IDEs & Editor configs
.idea/
.vscode/
.zcode/
.impeccable/

# Temporary exported packs
data/exports/*.zip

# Lint cache
.ruff_cache/

# 音频策略：文本与 meta 入库（语料是产品本体），音频不入库（可再生、体积大）
# 例外：初始提交中已跟踪的音频保持跟踪，避免状态不一致
data/topics/**/audio*.mp3
data/episodes/*.mp3

# 题库快照：可再生（python -m server.bank --sync），且源自 Bruce 私有 RoastDuck 数据，不入库
data/question_bank.json

# 任务运行态：服务重启恢复用，非产品数据
data/jobs.json

# Bruce 个性化学习包：脚本与文本入库，可再生的音频与卡片不入库
bruce_kit/audio/
bruce_kit/cards/

# glm-workflow 单题速通：文本源入库，可再生产物（音频/卡片/HTML）不入库
glm-workflow/output/

# Bruce 学习套件（organic 漫谈版）：脚本/文本/概念图入库；音频可由脚本再生，不入库
bruce_study_suite/audio/
/*.mp3
